# ============================================================
# Apache Spark + DataFusion Comet + TPC-DS v4 benchmark image
# Target: AWS Graviton4 (r8gd) — linux/arm64
#
# Bundles:
#   - Spark 4.1.3 + Scala 2.13 + Java 17
#   - Apache Iceberg 1.11.0 (Spark 4.0 runtime + AWS bundle, which includes
#     S3 Analytics Accelerator 1.3.1 for S3FileIO)
#   - Hadoop AWS 3.4.2 + AWS SDK v2
#   - Optional DataFusion Comet 1.2.0
#   - TPC-DS toolkit v4.0.0 (dsdgen/dsqgen)
#   - spark-sql-perf and spark-k8s-benchmarks compiled for Spark 4.1.3
#   - UID 185 non-root Spark user
#
# Build matrix (S3 AAL is a per-job Iceberg catalog setting, not an image change):
#   test1 + test2: --build-arg INCLUDE_COMET=true
#   test3:         --build-arg INCLUDE_COMET=false
#
# This image is intended for benchmark and demonstration workloads.
# ============================================================

# ============================================================
# Stage 1 — Build spark-sql-perf for Spark 4.1 / Scala 2.13
# ============================================================
FROM sbtscala/scala-sbt:eclipse-temurin-17.0.15_6_1.11.7_2.13.17 AS spark_sql_perf_builder

ARG SCALA_VERSION=2.13.17
ARG SPARK_VERSION=4.1.3
ARG SBT_VERSION=1.11.7
ARG SPARK_SQL_PERF_REF=17f7b1b898a6d22c10798ad3c447687de35e31df

RUN git init /build/spark-sql-perf && \
    cd /build/spark-sql-perf && \
    git remote add origin https://github.com/KubedAI/spark-sql-perf.git && \
    git fetch --depth 1 origin ${SPARK_SQL_PERF_REF} && \
    git checkout --detach FETCH_HEAD && \
    sed -i 's/createDataFrame(currentResults)/createDataFrame(currentResults.toSeq)/' \
      src/main/scala/com/databricks/spark/sql/perf/Benchmark.scala && \
    sed -i 's/createDataFrame(currentRuns)/createDataFrame(currentRuns.toSeq)/' \
      src/main/scala/com/databricks/spark/sql/perf/Benchmark.scala && \
    sed -i '0,/() => Unit,/s//() => (),/' \
      src/main/scala/com/databricks/spark/sql/perf/Benchmark.scala && \
    sed -i 's/prepare = () => Unit/prepare = () => ()/' \
      src/main/scala/com/databricks/spark/sql/perf/DatasetPerformance.scala && \
    sed -i 's/(row: Any) => Unit/(row: Any) => ()/' \
      src/main/scala/com/databricks/spark/sql/perf/Query.scala
WORKDIR /build/spark-sql-perf

RUN rm -f project/plugins.sbt && \
    mkdir -p project && \
    printf '%s\n' 'addSbtPlugin("com.eed3si9n" % "sbt-assembly" % "2.2.0")' > project/plugins.sbt && \
    printf 'sbt.version=%s\n' "${SBT_VERSION}" > project/build.properties

RUN cat > build.sbt <<SBT
name := "spark-sql-perf"
organization := "com.databricks"
version := "0.5.1-SNAPSHOT"
scalaVersion := "${SCALA_VERSION}"

val sparkVer = "${SPARK_VERSION}"

libraryDependencies ++= Seq(
  "org.apache.spark" %% "spark-sql"   % sparkVer % "provided",
  "org.apache.spark" %% "spark-hive"  % sparkVer % "provided",
  "org.apache.spark" %% "spark-mllib" % sparkVer % "provided",
  "com.github.scopt" %% "scopt"       % "3.7.1",
  "com.twitter"      %% "util-jvm"    % "24.2.0" % "provided",
  "org.yaml"         %  "snakeyaml"   % "2.2"
)

// TPC-DS does not use these legacy MLLib helpers. They rely on Scala 2.12
// APIs that were removed before the Spark 4.1 / Scala 2.13 runtime.
Compile / unmanagedSources / excludeFilter := new SimpleFileFilter(file =>
  (file.getPath.contains("/mllib/") && file.getName != "ReflectionUtils.scala") ||
  file.getPath.contains("/org/apache/spark/ml/"))
SBT

RUN sbt -Dsbt.override.build.repos=true -batch clean package

# ============================================================
# Stage 2 — Build the TPC-DS benchmark application
# ============================================================
FROM sbtscala/scala-sbt:eclipse-temurin-17.0.15_6_1.11.7_2.13.17 AS benchmark_builder

ARG SCALA_VERSION=2.13.17
ARG SPARK_VERSION=4.1.3
ARG SBT_VERSION=1.11.7
ARG SPARK_K8S_BENCHMARKS_REF=1bbe3800f2f724f143957a6dc18c5773d84bdb17

RUN git init /build/spark-k8s-benchmarks && \
    cd /build/spark-k8s-benchmarks && \
    git remote add origin https://github.com/KubedAI/spark-k8s-benchmarks.git && \
    git fetch --depth 1 origin ${SPARK_K8S_BENCHMARKS_REF} && \
    git checkout --detach FETCH_HEAD
WORKDIR /build/spark-k8s-benchmarks

RUN mkdir -p lib && \
    mkdir -p project && \
    printf '%s\n' 'addSbtPlugin("com.eed3si9n" % "sbt-assembly" % "2.2.0")' > project/plugins.sbt && \
    printf 'sbt.version=%s\n' "${SBT_VERSION}" > project/build.properties

COPY --from=spark_sql_perf_builder /build/spark-sql-perf/target/scala-2.13/*.jar lib/

RUN cat > build.sbt <<SBT
name := "spark-k8s-benchmarks"
organization := "com.k8s.spark"
version := "1.0.0"
scalaVersion := "${SCALA_VERSION}"

val sparkVersion = "${SPARK_VERSION}"

libraryDependencies ++= Seq(
  "org.apache.spark" %% "spark-sql"   % sparkVersion % "provided",
  "org.apache.spark" %% "spark-hive"  % sparkVersion % "provided",
  "org.apache.spark" %% "spark-mllib" % sparkVersion % "provided",
  "com.github.scopt" %% "scopt"       % "3.7.1",
  "com.twitter"      %% "util-jvm"    % "24.2.0",
  "org.yaml"         %  "snakeyaml"   % "2.2"
)

Compile / unmanagedJars :=
  (Compile / unmanagedBase).value.listFiles().filter(_.getName.endsWith(".jar")).toSeq.classpath

assembly / assemblyMergeStrategy := {
  case PathList("META-INF", xs @ _*) => xs match {
    case "MANIFEST.MF" :: Nil => MergeStrategy.discard
    case "services" :: _      => MergeStrategy.concat
    case _                     => MergeStrategy.discard
  }
  case "reference.conf" => MergeStrategy.concat
  case _                 => MergeStrategy.first
}

assembly / assemblyJarName := "spark-k8s-benchmarks-assembly-1.0.0.jar"

assembly / assemblyExcludedJars := {
  val cp = (assembly / fullClasspath).value
  cp.filter { file =>
    file.data.getName.contains("spark-") ||
    file.data.getName.contains("hadoop-") ||
    file.data.getName.contains("scala-")
  }
}

javacOptions ++= Seq("-source", "17", "-target", "17")
scalacOptions ++= Seq("-deprecation", "-feature", "-unchecked")
SBT

RUN sbt -Dsbt.override.build.repos=true -batch clean assembly

# ============================================================
# Stage 3 — Build the TPC-DS toolkit
# ============================================================
FROM ubuntu:22.04 AS tpcds_builder

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      bison ca-certificates flex gcc git libc6-dev make && \
    rm -rf /var/lib/apt/lists/*

RUN git clone --depth 1 --branch v4.0.0 \
      https://github.com/heyujiao99/tpcds-kit.git /opt/tpcds-kit && \
    cd /opt/tpcds-kit/tools && \
    make OS=LINUX CFLAGS="-D_FILE_OFFSET_BITS=64 -D_LARGEFILE_SOURCE -DYYDEBUG -DLINUX -g -Wall -fcommon"

# ============================================================
# Stage 4 — Spark 4.1 runtime for Graviton4 / ARM64
# ============================================================
FROM apache/spark:4.1.3-scala2.13-java17-python3-ubuntu

ARG SPARK_VERSION=4.1.3
ARG COMET_SPARK_VERSION=4.1
ARG HADOOP_VERSION=3.4.2
ARG AWS_SDK_VERSION=2.29.52
ARG COMET_VERSION=1.2.0
ARG ICEBERG_VERSION=1.11.0
ARG SCALA_BINARY=2.13
ARG SPARK_UID=185
ARG SPARK_GID=185

ENV SPARK_HOME=/opt/spark
ENV PATH=${SPARK_HOME}/bin:${SPARK_HOME}/sbin:${PATH}
ENV JAVA_HOME=/opt/java/openjdk

USER root
WORKDIR ${SPARK_HOME}

RUN apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates wget && \
    rm -rf /var/lib/apt/lists/* && \
    (groupadd -g ${SPARK_GID} spark 2>/dev/null || true) && \
    (useradd -m -u ${SPARK_UID} -g ${SPARK_GID} -s /bin/bash spark 2>/dev/null || true)

# Spark 4.1.3 supplies Hadoop 3.4.2 core libraries. Add the matching S3A,
# AWS SDK, Spark cloud, and Iceberg artifacts shared by all three tests.
RUN cd ${SPARK_HOME}/jars && \
    rm -f \
      hadoop-aws-*.jar \
      bundle-*.jar \
      analyticsaccelerator-s3-*.jar \
      spark-hadoop-cloud_*.jar \
      comet-spark-*.jar \
      iceberg-spark-runtime-*.jar \
      iceberg-aws-bundle-*.jar && \
    wget -q https://repo1.maven.org/maven2/org/apache/hadoop/hadoop-aws/${HADOOP_VERSION}/hadoop-aws-${HADOOP_VERSION}.jar && \
    wget -q https://repo1.maven.org/maven2/software/amazon/awssdk/bundle/${AWS_SDK_VERSION}/bundle-${AWS_SDK_VERSION}.jar && \
    wget -q https://repo1.maven.org/maven2/org/apache/spark/spark-hadoop-cloud_${SCALA_BINARY}/${SPARK_VERSION}/spark-hadoop-cloud_${SCALA_BINARY}-${SPARK_VERSION}.jar && \
    wget -q https://repo1.maven.org/maven2/org/apache/iceberg/iceberg-spark-runtime-4.0_${SCALA_BINARY}/${ICEBERG_VERSION}/iceberg-spark-runtime-4.0_${SCALA_BINARY}-${ICEBERG_VERSION}.jar && \
    wget -q https://repo1.maven.org/maven2/org/apache/iceberg/iceberg-aws-bundle/${ICEBERG_VERSION}/iceberg-aws-bundle-${ICEBERG_VERSION}.jar

# S3 Analytics Accelerator (AAL): iceberg-aws-bundle 1.11.0 already contains
# AAL 1.3.1, which is what Iceberg's S3FileIO uses. Iceberg data reads go
# through S3FileIO, not S3A, so AAL is switched on per job with the catalog
# property s3.analytics-accelerator.enabled=true. Do not add a standalone
# analyticsaccelerator-s3 jar: a second copy of the same classes on the
# classpath makes the loaded version unpredictable.
#
# Image matrix:
#   INCLUDE_COMET=true  -> test1 (Comet) and test2 (Comet + AAL config)
#   INCLUDE_COMET=false -> test3 (Spark + AAL config)
ARG INCLUDE_COMET=true

RUN case "${INCLUDE_COMET}" in true|false) ;; *) echo "INCLUDE_COMET must be true or false" >&2; exit 1 ;; esac && \
    cd ${SPARK_HOME}/jars && \
    if [ "${INCLUDE_COMET}" = "true" ]; then \
      wget -q https://repo1.maven.org/maven2/org/apache/datafusion/comet-spark-spark${COMET_SPARK_VERSION}_${SCALA_BINARY}/${COMET_VERSION}/comet-spark-spark${COMET_SPARK_VERSION}_${SCALA_BINARY}-${COMET_VERSION}.jar; \
    fi

LABEL org.opencontainers.image.title="Data on EKS Spark Iceberg benchmark" \
      org.opencontainers.image.description="Spark ${SPARK_VERSION}, Iceberg ${ICEBERG_VERSION}, optional Comet" \
      org.opencontainers.image.version="spark-${SPARK_VERSION}-iceberg-${ICEBERG_VERSION}" \
      io.data-on-eks.comet.enabled="${INCLUDE_COMET}"

COPY --from=tpcds_builder /opt/tpcds-kit /opt/tpcds-kit
COPY --from=tpcds_builder /opt/tpcds-kit/tools/dsdgen /usr/local/bin/dsdgen
COPY --from=tpcds_builder /opt/tpcds-kit/tools/dsqgen /usr/local/bin/dsqgen

COPY --from=spark_sql_perf_builder /build/spark-sql-perf/target/scala-2.13/*.jar \
    ${SPARK_HOME}/jars/
COPY --from=benchmark_builder /build/spark-k8s-benchmarks/target/scala-2.13/*.jar \
    ${SPARK_HOME}/jars/

RUN chown -R spark:spark ${SPARK_HOME} /opt/tpcds-kit

USER ${SPARK_UID}
WORKDIR ${SPARK_HOME}

ENTRYPOINT ["/opt/entrypoint.sh"]

{
  "uid": "agw-demo-tenants",
  "title": "agw-demo \u00b7 Tenant chargeback & SLOs",
  "description": "agentgateway + Ray Serve: per-team usage, cost, limits, latency, availability.",
  "tags": [
    "agw-demo",
    "agentgateway",
    "chargeback"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "label": "Data source",
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        }
      },
      {
        "name": "team",
        "label": "Team (tenant)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": {
          "query": "label_values(agentgateway_requests_total{gateway=\"agentgateway-system/agw-demo-gw\", team!=\"unknown\"}, team)",
          "refId": "team"
        },
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "sort": 1
      },
      {
        "name": "embed_rate",
        "label": "gRPC embed $ / 1M tokens",
        "type": "constant",
        "query": "0.01",
        "hide": 2,
        "description": "Internal rate for gRPC embedding tokens (same as the catalog's qwen3-embedding-0.6b input rate)."
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "1 \u00b7 Usage metering & team chargeback  (totals for the selected time range)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "id": 2,
      "title": "Total cost (USD)",
      "description": "LLM cost priced by agentgateway's model catalog + gRPC embedding tokens x internal rate.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum(increase(agentgateway_gen_ai_client_cost_usd_total{gateway=\"agentgateway-system/agw-demo-gw\", team=~\"$team\"}[$__range])) or vector(0)) + (sum(increase(ray_embed_tokens_total{protocol=\"grpc\", team=~\"$team\"}[$__range])) * $embed_rate / 1e6 or vector(0))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "decimals": 4
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "stat",
      "id": 3,
      "title": "Requests",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(agentgateway_requests_total{gateway=\"agentgateway-system/agw-demo-gw\", team=~\"$team\"}[$__range]))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      }
    },
    {
      "type": "stat",
      "id": 4,
      "title": "Tokens (LLM in + out, HTTP embeddings)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(agentgateway_gen_ai_client_token_usage_sum{gateway=\"agentgateway-system/agw-demo-gw\", team=~\"$team\"}[$__range]))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      }
    },
    {
      "type": "stat",
      "id": 5,
      "title": "gRPC embedding tokens",
      "description": "Counted by the embeddings service from the gateway-injected x-team-id header.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(ray_embed_tokens_total{protocol=\"grpc\", team=~\"$team\"}[$__range]))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      }
    },
    {
      "type": "table",
      "id": 6,
      "title": "Chargeback by team",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Export: panel menu > Inspect > Data > Download CSV. Totals for the dashboard time range.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (team) (increase(agentgateway_requests_total{gateway=\"agentgateway-system/agw-demo-gw\", team=~\"$team\"}[$__range]))",
          "legendFormat": "",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (team) (increase(agentgateway_gen_ai_client_token_usage_sum{gateway=\"agentgateway-system/agw-demo-gw\", team=~\"$team\", gen_ai_token_type=\"input\"}[$__range]))",
          "legendFormat": "",
          "refId": "B",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (team) (increase(agentgateway_gen_ai_client_token_usage_sum{gateway=\"agentgateway-system/agw-demo-gw\", team=~\"$team\", gen_ai_token_type=\"output\"}[$__range]))",
          "legendFormat": "",
          "refId": "C",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (team) (increase(ray_embed_tokens_total{protocol=\"grpc\", team=~\"$team\"}[$__range]))",
          "legendFormat": "",
          "refId": "D",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (team) (increase(agentgateway_gen_ai_client_cost_usd_total{gateway=\"agentgateway-system/agw-demo-gw\", team=~\"$team\"}[$__range]))",
          "legendFormat": "",
          "refId": "E",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (team) (increase(ray_embed_tokens_total{protocol=\"grpc\", team=~\"$team\"}[$__range])) * $embed_rate / 1e6",
          "legendFormat": "",
          "refId": "F",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "(sum by (team) (increase(agentgateway_gen_ai_client_cost_usd_total{gateway=\"agentgateway-system/agw-demo-gw\", team=~\"$team\"}[$__range])) or sum by (team) (increase(ray_embed_tokens_total{protocol=\"grpc\", team=~\"$team\"}[$__range])) * 0) + (sum by (team) (increase(ray_embed_tokens_total{protocol=\"grpc\", team=~\"$team\"}[$__range])) * $embed_rate / 1e6 or sum by (team) (increase(agentgateway_gen_ai_client_cost_usd_total{gateway=\"agentgateway-system/agw-demo-gw\", team=~\"$team\"}[$__range])) * 0)",
          "legendFormat": "",
          "refId": "G",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (team) (increase(agentgateway_requests_total{gateway=\"agentgateway-system/agw-demo-gw\", team=~\"$team\", status=\"429\"}[$__range]))",
          "legendFormat": "",
          "refId": "H",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (team) (increase(agentgateway_requests_total{gateway=\"agentgateway-system/agw-demo-gw\", team=~\"$team\", status=~\"5..\"}[$__range]))",
          "legendFormat": "",
          "refId": "I",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "team": "Team",
              "Value #A": "Requests",
              "Value #B": "Input tokens",
              "Value #C": "Output tokens",
              "Value #D": "gRPC embed tokens",
              "Value #E": "LLM cost $",
              "Value #F": "gRPC embed cost $",
              "Value #G": "Total cost $",
              "Value #H": "Rate-limited (429)",
              "Value #I": "Errors (5xx)"
            },
            "indexByName": {
              "team": 0
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "sort": [
              {
                "field": "Total cost $",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Requests"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Input tokens"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Output tokens"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "gRPC embed tokens"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "LLM cost $"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 4
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "gRPC embed cost $"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 4
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Total cost $"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 4
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Rate-limited (429)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Errors (5xx)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Total cost $"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Rate-limited (429)"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": true,
          "reducer": [
            "sum"
          ],
          "fields": [
            "Requests",
            "Input tokens",
            "Output tokens",
            "gRPC embed tokens",
            "LLM cost $",
            "gRPC embed cost $",
            "Total cost $",
            "Rate-limited (429)",
            "Errors (5xx)"
          ]
        }
      },
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 5
      }
    },
    {
      "type": "piechart",
      "id": 7,
      "title": "Cost share by team",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (team) (increase(agentgateway_gen_ai_client_cost_usd_total{gateway=\"agentgateway-system/agw-demo-gw\", team=~\"$team\"}[$__range])) + on(team) group_left() (sum by (team) (increase(ray_embed_tokens_total{protocol=\"grpc\", team=~\"$team\"}[$__range])) * $embed_rate / 1e6 or sum by (team) (increase(agentgateway_gen_ai_client_cost_usd_total{gateway=\"agentgateway-system/agw-demo-gw\", team=~\"$team\"}[$__range])) * 0)",
          "legendFormat": "{{team}}",
          "refId": "A",
          "instant": true,
          "range": false,
          "format": "time_series"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 4
        },
        "overrides": []
      },
      "options": {
        "pieType": "donut",
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        },
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 5
      }
    },
    {
      "type": "timeseries",
      "id": 8,
      "title": "Spend rate by team ($ / hour)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (team) (rate(agentgateway_gen_ai_client_cost_usd_total{gateway=\"agentgateway-system/agw-demo-gw\", team=~\"$team\"}[5m])) * 3600",
          "legendFormat": "{{team}} LLM",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (team) (rate(ray_embed_tokens_total{protocol=\"grpc\", team=~\"$team\"}[5m])) * $embed_rate / 1e6 * 3600",
          "legendFormat": "{{team}} gRPC embed",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      }
    },
    {
      "type": "timeseries",
      "id": 9,
      "title": "Tokens / second by team and type",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (team, gen_ai_token_type) (rate(agentgateway_gen_ai_client_token_usage_sum{gateway=\"agentgateway-system/agw-demo-gw\", team=~\"$team\"}[5m]))",
          "legendFormat": "{{team}} {{gen_ai_token_type}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum by (team) (rate(ray_embed_tokens_total{protocol=\"grpc\", team=~\"$team\"}[5m]))",
          "legendFormat": "{{team}} grpc-embed",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
